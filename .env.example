# ==============================================================================
# .env.example
# Vorlage für Umgebungsvariablen der PaperlessPaper Firmware & HIL-Testbench.
# Kopiere diese Datei nach '.env' und trage die entsprechenden Werte ein.
# ACHTUNG: '.env' darf NIEMALS in ein öffentliches Repository eingecheckt werden!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firmware Build & Deployment (PlatformIO / set_env.py)
# ------------------------------------------------------------------------------
ENV_WIFI_SSID_DEPLOY="YourDeploymentWiFiSSID"
ENV_WIFI_PW_DEPLOY="YourDeploymentWiFiPassword"

ENV_OTA_URL="http://your-ota-server.com/espfota_epd7.json"
ENV_OTA_URL_DEV="http://your-ota-server.com/espfota_epd7_dev.json"
ENV_OTA_URL_13="http://your-ota-server.com/espfota_epd13.json"
ENV_OTA_URL_DEV_13="http://your-ota-server.com/espfota_epd13_dev.json"
ENV_DOWNLOAD_URL="http://your-ota-server.com/"

ENV_SLEEP_SCREEN_URL_7="https://your-domain.com/download/cover_7.bmp"
ENV_SLEEP_SCREEN_URL_13="https://your-domain.com/download/cover.bmp"

# ------------------------------------------------------------------------------
# 2. CI Pre-Flight & KI Risikoanalyse (tools/ai_risk_analysis.py)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# 3. Hardware-in-the-Loop (HIL) Testbench - Lokale Test-Umgebung
# ------------------------------------------------------------------------------
# Lokales Test-WLAN für BLE-Provisionierung & Verbindungstests
HIL_WIFI_SSID="your-testbench-wifi-ssid"
HIL_WIFI_PASSWORD="your-testbench-wifi-password"

# Auth0 M2M Client Credentials für API-Zugriff
AUTH0_DOMAIN="your-tenant.eu.auth0.com"
AUTH0_CLIENT_ID="your-auth0-client-id"
AUTH_0_CLIENT_SECRET="your-auth0-client-secret"
AUTH_0_AUDIENCE="localhost:3000/"
AUTH_0_GRANT_TYPE="client_credentials"

# AWS API-Gateway & Backend Endpunkte
HIL_API_BASE_URL="https://your-api-id.execute-api.eu-central-1.amazonaws.com/Prod"
HIL_S3_BUCKET="your-s3-bucket-name"
AWS_IOT_ENDPOINT="https://your-endpoint-ats.iot.eu-central-1.amazonaws.com"
AWS_REGION="eu-central-1"

# AWS IAM Credentials (nur für Verifizierung in DynamoDB & S3)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# DynamoDB Tabellennamen (Standard: iotCatalog, iotPayload)
DYNAMODB_CATALOG_TABLE="iotCatalog"
DYNAMODB_PAYLOAD_TABLE="iotPayload"
